local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local COOLDOWN = 0.01 
local lastClick = 0
local isHolding = false 

local AutomaticWeapons = {
    ["MP5"] = true,
    ["M4A1"] = true,
    ["AK-47"] = true
}

local function isHoldingAutomatic()
    local character = LocalPlayer.Character
    if character then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool and AutomaticWeapons[tool.Name] then
            return true
        end
    end
    return false
end

local function triggerWeapon(shouldFire)
    if not isrbxactive() then 
        if isHolding then
            mouse1release()
            isHolding = false
        end
        return 
    end

    if shouldFire then
        if isHoldingAutomatic() then
            if not isHolding then
                mouse1press()
                isHolding = true
            end
        else
            if isHolding then
                mouse1release()
                isHolding = false
            end
            mouse1click()
        end
    else
        if isHolding then
            mouse1release()
            isHolding = false
        end
    end
end

local function isHostileInmate(targetPlayer)
    local character = targetPlayer.Character
    if not character then return false end
    
    local head = character:FindFirstChild("Head")
    if head then
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("BillboardGui") then
                local textLabel = child:FindFirstChildOfClass("TextLabel")
                if textLabel and string.find(textLabel.Text, "💢") then
                    return true
                end
            end
        end
    end
    
    if character:GetAttribute("Hostile") == true then
        return true
    end
    
    return false
end

RunService.RenderStepped:Connect(function()
    local currentTime = os.clock()
    if currentTime - lastClick < COOLDOWN then return end
    
    local target = Mouse.Target
    if target and target.Parent then
        local character = target.Parent
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if not humanoid and character.Parent then
            character = character.Parent
            humanoid = character:FindFirstChildOfClass("Humanoid")
        end
        
        if humanoid and humanoid.Health > 0 then
            local targetPlayer = Players:GetPlayerFromCharacter(character)
            
            if targetPlayer and targetPlayer ~= LocalPlayer then
                if LocalPlayer.Team == targetPlayer.Team and LocalPlayer.Team ~= nil then
                    triggerWeapon(false)
                    return 
                end
                
                local targetTeamName = targetPlayer.Team and targetPlayer.Team.Name or ""

                if targetTeamName == "Inmates" then
                    if isHostileInmate(targetPlayer) then
                        lastClick = currentTime
                        triggerWeapon(true)
                    else
                        triggerWeapon(false)
                    end
                elseif targetTeamName == "Criminals" or targetTeamName == "Guards" then
                    lastClick = currentTime
                    triggerWeapon(true)
                else
                    lastClick = currentTime
                    triggerWeapon(true)
                end
                return 
            end
        end
    end
    
    triggerWeapon(false)
end)
